# Copy this file to .env for local CLI mode. Do not commit .env.
# Required: use a local MySQL/TiDB database URL.
DATABASE_URL=mysql://godmode:change-me@127.0.0.1:3306/godmode_ai

# Required: use a long random value. It encrypts provider keys stored in your local database.
JWT_SECRET=replace-with-a-long-random-secret

# Optional local operator label shown in the app.
GODMODE_LOCAL_USER_NAME=Local Operator

# Optional. Leave empty for local provider-only operation. The managed fallback needs host-provided credentials.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
